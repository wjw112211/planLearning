<launch>
  <arg name="model" default="burger" doc="TurtleBot3 model: burger, waffle, waffle_pi"/>
  <arg name="robot_name" default="turtlebot3_grid_map"/>
  <arg name="world_name"
       default="$(find turtlebot3_gazebo)/worlds/turtlebot3_world.world"/>
  <arg name="x_pos" default="-2.0"/>
  <arg name="y_pos" default="-0.5"/>
  <arg name="z_pos" default="0.0"/>
  <arg name="use_static_map" default="true"/>
  <arg name="static_map_type" default="turtlebot3_world"/>
  <arg name="run_slam" default="false"/>
  <arg name="run_autonomous_drive" default="false"/>
  <arg name="launch_rviz" default="true"/>
  <!-- 速度指令看门狗：超时没有新指令就停车 -->
  <arg name="launch_cmd_vel_watchdog" default="true"/>
  <arg name="cmd_vel_timeout" default="0.5"/>
  <!-- 代价地图参数，透传给 grid_map_gazebo_bridge -->
  <arg name="lethal_threshold" default="65"/>
  <arg name="inscribed_radius" default="0.20"/>
  <arg name="inflation_radius" default="0.50"/>
  <arg name="cost_scaling_factor" default="10.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro
                  $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_footprint_to_base_link"
        args="0 0 0.01 0 0 0 base_footprint base_link"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_base_scan"
        args="-0.032 0 0.172 0 0 0 base_link base_scan"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_wheel_left"
        args="0 0.08 0.023 0 0 -1.57 base_link wheel_left_link"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_wheel_right"
        args="0 -0.08 0.023 0 0 -1.57 base_link wheel_right_link"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_caster_back"
        args="-0.081 0 -0.004 0 0 -1.57 base_link caster_back_link"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_imu"
        args="-0.032 0 0.068 0 0 0 base_link imu_link"/>

  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_turtlebot3"
        output="screen"
        args="-urdf -model $(arg robot_name)
              -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos)
              -param robot_description"/>

  <!-- Gazebo 差速驱动插件没有指令超时，停止发送 /cmd_vel 后需要用看门狗把机器人停下。 -->
  <node pkg="turtlebot3_gazebo"
        type="cmd_vel_watchdog"
        name="cmd_vel_watchdog"
        output="screen"
        if="$(arg launch_cmd_vel_watchdog)">
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="timeout" value="$(arg cmd_vel_timeout)"/>
    <param name="publish_rate" value="20.0"/>
  </node>

  <!-- Build a 2D map from Gazebo's simulated laser and odometry. -->
  <node pkg="gmapping"
        type="slam_gmapping"
        name="slam_gmapping"
        output="screen"
        if="$(arg run_slam)">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="4.0"/>
    <param name="minimumScore" value="50"/>
    <param name="linearUpdate" value="0.15"/>
    <param name="angularUpdate" value="0.15"/>
    <param name="temporalUpdate" value="0.5"/>
    <param name="delta" value="0.05"/>
    <param name="particles" value="80"/>
    <param name="xmin" value="-20.0"/>
    <param name="ymin" value="-20.0"/>
    <param name="xmax" value="20.0"/>
    <param name="ymax" value="20.0"/>
  </node>

  <include file="$(find grid_map_gazebo_bridge)/launch/static_map.launch"
           if="$(arg use_static_map)">
    <arg name="map_type" value="$(arg static_map_type)"/>
  </include>

  <include file="$(find grid_map_gazebo_bridge)/launch/grid_map_gazebo_bridge.launch">
    <arg name="lethal_threshold" value="$(arg lethal_threshold)"/>
    <arg name="inscribed_radius" value="$(arg inscribed_radius)"/>
    <arg name="inflation_radius" value="$(arg inflation_radius)"/>
    <arg name="cost_scaling_factor" value="$(arg cost_scaling_factor)"/>
  </include>

  <!-- Retain the existing simple autonomous driver, but make it optional. -->
  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_simulation.launch"
           if="$(arg run_autonomous_drive)"/>

  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find turtlebot3_gazebo)/rviz/gazebo_grid_map.rviz"
        output="screen"
        if="$(arg launch_rviz)"/>
</launch>
