<launch>
  <arg name="grid_map_topic" default="/grid_map"/>

  <node pkg="grid_map_visualization"
        type="grid_map_visualization"
        name="grid_map_visualization"
        output="screen">
    <param name="grid_map_topic" value="$(arg grid_map_topic)"/>
    <rosparam param="grid_map_visualizations">
      - name: occupancy_grid
        type: occupancy_grid
        params:
          layer: occupancy
          data_min: 0.0
          data_max: 100.0
      - name: flat_grid
        type: flat_point_cloud
        params:
          height: 0.0
    </rosparam>
  </node>
</launch>
