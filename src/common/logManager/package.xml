<?xml version="1.0"?>
<package format="2">
  <name>logManager</name>
  <version>0.1.0</version>
  <description>基于 glog 的日志管理：日志离线保存到工程根目录 log/ 下，支持定时清理和按时间节流打印。</description>

  <maintainer email="wjw@todo.todo">wjw</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>libgoogle-glog-dev</depend>
</package>
